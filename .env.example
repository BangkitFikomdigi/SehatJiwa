# ================================
# Postgres (local) + Better Auth
# ================================
DATABASE_URL=postgresql://sehatjiwa:[REDACTED]@localhost:5432/sehatjiwa
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# Upstash Redis (rate limit chat AI & cache library)
# ================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ================================
# Google Cloud AI (Gemini)
# ================================
GOOGLE_AI_API_KEY=

# ================================
# Dev: Skip Auth (untuk teman testing)
# ================================
# Set ke "true" agar dashboard bisa diakses tanpa login. Default: false (auth required)
NEXT_PUBLIC_SKIP_AUTH=false
